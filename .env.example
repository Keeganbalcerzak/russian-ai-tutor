# Copy this file to .env and fill in your values.

# Local SQLite database (default is fine)
DATABASE_URL="file:./dev.db"

# OpenAI API key — required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API key — required if not using OpenAI. Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# ElevenLabs API key — optional for ultra-realistic neural TTS. Get one at https://elevenlabs.io/
# ELEVENLABS_API_KEY=

# Optional model overrides (defaults applied if unset)
# OPENAI_CHAT_MODEL=gpt-5.1-chat-latest
# OPENAI_ANALYZER_MODEL=gpt-5-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
